# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# square_flute names its own sheets, so each command writes one variant into
# $OUT's directory with --flat and the tool compares the file it asked for.
# The programs are Rust since 2026-11-07, built by repro-svg before these run;
# the crate borrows swept-curve's path writer and bore-tmm's note search, so
# these commands expect those checkouts beside this one.

# --- the cut files, six builds, each with both halves of the flue ---
cut-files/box-square-3/square-flute-A4-box-square-3-sheet1-cut-files.svg :: target/release/square_flute --only=box-square-3 --flat --out=$(dirname $OUT)
cut-files/box-square-3-flat/square-flute-A4-box-square-3-flat-sheet1-cut-files.svg :: target/release/square_flute --only=box-square-3-flat --flat --out=$(dirname $OUT)
cut-files/box-square-6/square-flute-A4-box-square-6-sheet1-cut-files.svg :: target/release/square_flute --only=box-square-6 --flat --out=$(dirname $OUT)
cut-files/box-square-6-flat/square-flute-A4-box-square-6-flat-sheet1-cut-files.svg :: target/release/square_flute --only=box-square-6-flat --flat --out=$(dirname $OUT)
cut-files/stack-rect-3/square-flute-A4-stack-rect-3-sheet1-cut-files.svg :: target/release/square_flute --only=stack-rect-3 --flat --out=$(dirname $OUT)
cut-files/stack-rect-6/square-flute-A4-stack-rect-6-sheet1-cut-files.svg :: target/release/square_flute --only=stack-rect-6 --flat --out=$(dirname $OUT)

# --- display renderings of them, never cut files ---
previews/box-square-3/square-flute-A4-box-square-3-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/box-square-3/square-flute-A4-box-square-3-sheet1-cut-files.svg $OUT
previews/box-square-3-flat/square-flute-A4-box-square-3-flat-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/box-square-3-flat/square-flute-A4-box-square-3-flat-sheet1-cut-files.svg $OUT
previews/box-square-6/square-flute-A4-box-square-6-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/box-square-6/square-flute-A4-box-square-6-sheet1-cut-files.svg $OUT
previews/box-square-6-flat/square-flute-A4-box-square-6-flat-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/box-square-6-flat/square-flute-A4-box-square-6-flat-sheet1-cut-files.svg $OUT
previews/stack-rect-3/square-flute-A4-stack-rect-3-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/stack-rect-3/square-flute-A4-stack-rect-3-sheet1-cut-files.svg $OUT
previews/stack-rect-6/square-flute-A4-stack-rect-6-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/stack-rect-6/square-flute-A4-stack-rect-6-sheet1-cut-files.svg $OUT

# --- the pages ---
viewer.js :: target/release/page_assets --viewer-to=$OUT
turn.html :: target/release/page_assets --turn-to=$OUT
plans/square-flute-A4-holes-3mm-wall.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
plans/square-flute-A4-holes-6mm-wall.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the author's flute: only its leather tie is drawn, by your_flute ---
yours/cut-files/your-flute-leather-tie-cut-files.svg :: target/release/your_flute --out=$(dirname $OUT)
yours/previews/your-flute-leather-tie-cut-files.svg :: ../lasermade-tools/target/release/make-preview yours/cut-files/your-flute-leather-tie-cut-files.svg $OUT

# --- the author's originals, from 2017, as they were given: drawn by hand in
# Inkscape, so no generator exists for them, and they are kept unchanged on
# purpose. your_flute measured them; it does not draw them.
yours/original/AirPlug.svg :: !
yours/original/Block.svg :: !
yours/original/BubingaAirPlug.svg :: !
yours/original/FluteEdge.svg :: !
yours/original/HoleWithDepression.svg :: !
yours/original/LeatherStrip.svg :: !
yours/original/Mouthpiece.svg :: !
yours/original/NAF_fingerjoints.svg :: !
yours/original/NAF_flatjoints.svg :: !
yours/original/NativeAmericaStyleFlute.svg :: !

# --- the STEP files: the 3D view's parts as solids for a CAD program, one
# file per design, written from the page by lasermade-tools' step-export ---
step/square-flute-box-square-3.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
step/square-flute-box-square-3-flat.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
step/square-flute-box-square-6.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
step/square-flute-box-square-6-flat.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
step/square-flute-stack-rect-3.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
step/square-flute-stack-rect-6.step :: ../lasermade-tools/target/release/step-export viewer.js --name=square-flute --out=$(dirname $OUT)
