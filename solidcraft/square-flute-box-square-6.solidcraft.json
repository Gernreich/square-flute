{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"sheet thickness: every plate, wall, layer and plug disc"}},
{"command":"parameters.add","params":{"name":"bore_ref","expression":"19.05 mm","comment":"the round bore whose area every build keeps (3/4in)"}},
{"command":"parameters.add","params":{"name":"bore_w","expression":"sqrt(pi)*bore_ref/2","comment":"read only: the square bore across, the reference's area"}},
{"command":"parameters.add","params":{"name":"bore_d","expression":"bore_w","comment":"read only: and deep"}},
{"command":"parameters.add","params":{"name":"pw","expression":"bore_w + 2*ply","comment":"read only: the flute across"}},
{"command":"parameters.add","params":{"name":"sac","expression":"110 mm","comment":"the slow air chamber, from the mouth end to the plug"}},
{"command":"parameters.add","params":{"name":"exit_l","expression":"6 mm","comment":"the exit hole along the flute, just before the plug"}},
{"command":"parameters.add","params":{"name":"plug_discs","expression":"4","unit":"","comment":"the plug's press-fit discs, each a body"}},
{"command":"parameters.add","params":{"name":"plug","expression":"plug_discs*ply","comment":"read only: the plug's length, the flue's run"}},
{"command":"parameters.add","params":{"name":"interf","expression":"0.12 mm","comment":"the plug discs' press-fit, over the bore each way"}},
{"command":"parameters.add","params":{"name":"window_l","expression":"7 mm","comment":"the window along the flute (it runs the bore's width)"}},
{"command":"parameters.add","params":{"name":"flue_depth","expression":"0.5 mm","comment":"each half of the flue, engraved in the top's outer face and the bird's underside"}},
{"command":"parameters.add","params":{"name":"wc","expression":"sac + plug + window_l/2","comment":"read only: the window's centre, where the tuning measures from"}},
{"command":"parameters.add","params":{"name":"chamber","expression":"352.1386511184346 mm","comment":"the sound chamber, window centre to the foot: naf_model's A4 for this bore and hole wall"}},
{"command":"parameters.add","params":{"name":"foot_spare","expression":"15 mm","comment":"cut this much long at the foot, trim to pitch"}},
{"command":"parameters.add","params":{"name":"h_1","expression":"251.62577149030236 mm","comment":"hole 1 (opens C5), from the window centre: the solver's"}},
{"command":"parameters.add","params":{"name":"d_1","expression":"7.654905806912666 mm","comment":"hole 1's diameter: the solver's"}},
{"command":"parameters.add","params":{"name":"h_2","expression":"226.62577149030236 mm","comment":"hole 2 (opens D5), from the window centre: the solver's"}},
{"command":"parameters.add","params":{"name":"d_2","expression":"8 mm","comment":"hole 2's diameter: the solver's"}},
{"command":"parameters.add","params":{"name":"h_3","expression":"201.62577149030236 mm","comment":"hole 3 (opens E5), from the window centre: the solver's"}},
{"command":"parameters.add","params":{"name":"d_3","expression":"9.190380796058434 mm","comment":"hole 3's diameter: the solver's"}},
{"command":"parameters.add","params":{"name":"h_4","expression":"149.2585749946852 mm","comment":"hole 4 (opens G5), from the window centre: the solver's"}},
{"command":"parameters.add","params":{"name":"d_4","expression":"8 mm","comment":"hole 4's diameter: the solver's"}},
{"command":"parameters.add","params":{"name":"h_5","expression":"124.2585749946852 mm","comment":"hole 5 (opens A5), from the window centre: the solver's"}},
{"command":"parameters.add","params":{"name":"d_5","expression":"6.576774121526341 mm","comment":"hole 5's diameter: the solver's"}},
{"command":"parameters.add","params":{"name":"total","expression":"wc + chamber + foot_spare","comment":"read only: the flute's length"}},
{"command":"parameters.add","params":{"name":"doubler_past","expression":"20 mm","comment":"the doubler runs this far past the outermost holes"}},
{"command":"parameters.add","params":{"name":"dz0","expression":"wc + min(min(min(h_1, h_2), min(h_3, h_4)), h_5) - doubler_past","comment":"read only: where the doubler starts"}},
{"command":"parameters.add","params":{"name":"dz1","expression":"wc + max(max(max(h_1, h_2), max(h_3, h_4)), h_5) + doubler_past","comment":"read only: and ends"}},
{"command":"parameters.add","params":{"name":"bird_upstream","expression":"6 mm","comment":"the bird starts this far before the exit hole"}},
{"command":"parameters.add","params":{"name":"cap_d","expression":"9.59 mm","comment":"the half-round notch in the cap and the bottom plate's mouth end"}},
{"command":"parameters.add","params":{"name":"notch_in","expression":"0.33 mm","comment":"the cap notch's centre, inside its bottom edge"}},
{"command":"parameters.add","params":{"name":"bed_room","expression":"600 mm - 2*5 mm - total","comment":"read only: bed length left past the longest part (the P2S's 600 mm)"}},
{"command":"parameters.add","params":{"name":"dmax","expression":"max(max(max(d_1, d_2), max(d_3, d_4)), d_5)","comment":"read only: the largest hole"}},
{"command":"parameters.add","params":{"name":"hole_room","expression":"bore_w - 2*1.5 mm - dmax","comment":"read only: room left for the largest hole inside the bore"}},
{"command":"parameters.add","params":{"name":"gap_room","expression":"min(min(h_1 - h_2 - (d_1 + d_2)/2, h_2 - h_3 - (d_2 + d_3)/2), min(h_3 - h_4 - (d_3 + d_4)/2, h_4 - h_5 - (d_4 + d_5)/2)) - 3 mm","comment":"read only: ply left between the closest two holes, past 3 mm"}},
{"command":"parameters.add","params":{"name":"finger","expression":"2*ply","comment":"a finger's width, and the space between two"}},
{"command":"parameters.add","params":{"name":"finger_end","expression":"2*finger","comment":"the fingers stay this far from each end"}},
{"command":"parameters.add","params":{"name":"finger_clear","expression":"3 mm","comment":"and this far from the exit hole and the window"}},
{"command":"parameters.add","params":{"name":"notch_room","expression":"pw/2 - dmax/2 - ply - 1.5 mm","comment":"read only: ply left between a hole and a finger notch"}},
{"command":"parameters.add","params":{"name":"pitch","expression":"2*finger","comment":"read only: finger to finger"}},
{"command":"parameters.add","params":{"name":"n_f","expression":"floor((total - 2*finger_end - finger)/pitch) + 1","unit":"","comment":"read only: finger places along the flute"}},
{"command":"parameters.add","params":{"name":"fx0","expression":"total/2 - (n_f - 1)*pitch/2","comment":"read only: the first finger place"}},
{"command":"parameters.add","params":{"name":"reach","expression":"finger/2 + finger_clear","comment":"read only: a finger's centre keeps this far from an opening"}},
{"command":"parameters.add","params":{"name":"n_a","expression":"max(0, min(n_f, floor((sac - exit_l - reach - fx0)/pitch + 1e-9) + 1))","unit":"","comment":"read only: fingers before the exit hole"}},
{"command":"parameters.add","params":{"name":"i_m","expression":"max(0, ceil((sac + reach - fx0)/pitch - 1e-9))","unit":"","comment":"read only: the first finger between the exit hole and the window"}},
{"command":"parameters.add","params":{"name":"n_m","expression":"max(0, min(n_f - 1, floor((sac + plug - reach - fx0)/pitch + 1e-9)) - i_m + 1)","unit":"","comment":"read only: fingers between them"}},
{"command":"parameters.add","params":{"name":"i_c","expression":"max(0, ceil((sac + plug + window_l + reach - fx0)/pitch - 1e-9))","unit":"","comment":"read only: the first finger past the window"}},
{"command":"parameters.add","params":{"name":"n_c","expression":"max(0, n_f - i_c)","unit":"","comment":"read only: fingers past the window"}},
{"command":"solid.box","params":{"corner":["0 mm","-pw/2","ply + bore_d"],"length":"(total) - (0 mm)","width":"(pw/2) - (-pw/2)","height":"(2*ply + bore_d) - (ply + bore_d)","operation":"new","name":"1 top plate","body_name":"1 top plate"}},
{"command":"solid.box","params":{"corner":["0 mm","-pw/2","0 mm"],"length":"(total) - (0 mm)","width":"(pw/2) - (-pw/2)","height":"(ply) - (0 mm)","operation":"new","name":"2 bottom plate","body_name":"2 bottom plate"}},
{"command":"solid.box","params":{"corner":["0 mm","bore_w/2","ply"],"length":"(total) - (0 mm)","width":"(bore_w/2 + ply) - (bore_w/2)","height":"(ply + bore_d) - (ply)","operation":"new","name":"3 side wall","body_name":"3 side wall"}},
{"command":"solid.box","params":{"corner":["fx0 + 0*pitch - finger/2","bore_w/2","(1 - min(1, n_a))*ply"],"length":"(fx0 + 0*pitch + finger/2) - (fx0 + 0*pitch - finger/2)","width":"(bore_w/2 + ply) - (bore_w/2)","height":"(2*ply + bore_d - (1 - min(1, n_a))*ply) - ((1 - min(1, n_a))*ply)","operation":"join","targets":["3 side wall"],"name":"fingers a, wall 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers a, wall 1"],"dir1":[1,0,0],"count1":"max(1, n_a)","spacing1":"pitch","name":"fingers a, wall 1 pattern"}},
{"command":"solid.box","params":{"corner":["fx0 + i_m*pitch - finger/2","bore_w/2","(1 - min(1, n_m))*ply"],"length":"(fx0 + i_m*pitch + finger/2) - (fx0 + i_m*pitch - finger/2)","width":"(bore_w/2 + ply) - (bore_w/2)","height":"(2*ply + bore_d - (1 - min(1, n_m))*ply) - ((1 - min(1, n_m))*ply)","operation":"join","targets":["3 side wall"],"name":"fingers m, wall 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers m, wall 1"],"dir1":[1,0,0],"count1":"max(1, n_m)","spacing1":"pitch","name":"fingers m, wall 1 pattern"}},
{"command":"solid.box","params":{"corner":["fx0 + i_c*pitch - finger/2","bore_w/2","(1 - min(1, n_c))*ply"],"length":"(fx0 + i_c*pitch + finger/2) - (fx0 + i_c*pitch - finger/2)","width":"(bore_w/2 + ply) - (bore_w/2)","height":"(2*ply + bore_d - (1 - min(1, n_c))*ply) - ((1 - min(1, n_c))*ply)","operation":"join","targets":["3 side wall"],"name":"fingers c, wall 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers c, wall 1"],"dir1":[1,0,0],"count1":"max(1, n_c)","spacing1":"pitch","name":"fingers c, wall 1 pattern"}},
{"command":"solid.box","params":{"corner":["0 mm","-bore_w/2 - ply","ply"],"length":"(total) - (0 mm)","width":"(-bore_w/2) - (-bore_w/2 - ply)","height":"(ply + bore_d) - (ply)","operation":"new","name":"4 side wall","body_name":"4 side wall"}},
{"command":"solid.box","params":{"corner":["fx0 + 0*pitch - finger/2","-bore_w/2 - ply","(1 - min(1, n_a))*ply"],"length":"(fx0 + 0*pitch + finger/2) - (fx0 + 0*pitch - finger/2)","width":"(-bore_w/2) - (-bore_w/2 - ply)","height":"(2*ply + bore_d - (1 - min(1, n_a))*ply) - ((1 - min(1, n_a))*ply)","operation":"join","targets":["4 side wall"],"name":"fingers a, wall 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers a, wall 2"],"dir1":[1,0,0],"count1":"max(1, n_a)","spacing1":"pitch","name":"fingers a, wall 2 pattern"}},
{"command":"solid.box","params":{"corner":["fx0 + i_m*pitch - finger/2","-bore_w/2 - ply","(1 - min(1, n_m))*ply"],"length":"(fx0 + i_m*pitch + finger/2) - (fx0 + i_m*pitch - finger/2)","width":"(-bore_w/2) - (-bore_w/2 - ply)","height":"(2*ply + bore_d - (1 - min(1, n_m))*ply) - ((1 - min(1, n_m))*ply)","operation":"join","targets":["4 side wall"],"name":"fingers m, wall 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers m, wall 2"],"dir1":[1,0,0],"count1":"max(1, n_m)","spacing1":"pitch","name":"fingers m, wall 2 pattern"}},
{"command":"solid.box","params":{"corner":["fx0 + i_c*pitch - finger/2","-bore_w/2 - ply","(1 - min(1, n_c))*ply"],"length":"(fx0 + i_c*pitch + finger/2) - (fx0 + i_c*pitch - finger/2)","width":"(-bore_w/2) - (-bore_w/2 - ply)","height":"(2*ply + bore_d - (1 - min(1, n_c))*ply) - ((1 - min(1, n_c))*ply)","operation":"join","targets":["4 side wall"],"name":"fingers c, wall 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["fingers c, wall 2"],"dir1":[1,0,0],"count1":"max(1, n_c)","spacing1":"pitch","name":"fingers c, wall 2 pattern"}},
{"command":"solid.box","params":{"corner":["sac + 0*ply","-(bore_w + interf)/2","ply"],"length":"(sac + 1*ply) - (sac + 0*ply)","width":"((bore_w + interf)/2) - (-(bore_w + interf)/2)","height":"(ply + bore_d + interf) - (ply)","operation":"new","name":"5 plug disc","body_name":"5 plug disc"}},
{"command":"solid.box","params":{"corner":["sac + 1*ply","-(bore_w + interf)/2","ply"],"length":"(sac + 2*ply) - (sac + 1*ply)","width":"((bore_w + interf)/2) - (-(bore_w + interf)/2)","height":"(ply + bore_d + interf) - (ply)","operation":"new","name":"6 plug disc","body_name":"6 plug disc"}},
{"command":"solid.box","params":{"corner":["sac + 2*ply","-(bore_w + interf)/2","ply"],"length":"(sac + 3*ply) - (sac + 2*ply)","width":"((bore_w + interf)/2) - (-(bore_w + interf)/2)","height":"(ply + bore_d + interf) - (ply)","operation":"new","name":"7 plug disc","body_name":"7 plug disc"}},
{"command":"solid.box","params":{"corner":["sac + 3*ply","-(bore_w + interf)/2","ply"],"length":"(sac + 4*ply) - (sac + 3*ply)","width":"((bore_w + interf)/2) - (-(bore_w + interf)/2)","height":"(ply + bore_d + interf) - (ply)","operation":"new","name":"8 plug disc","body_name":"8 plug disc"}},
{"command":"solid.box","params":{"corner":["dz0","-pw/2","2*ply + bore_d"],"length":"(dz1) - (dz0)","width":"(pw/2) - (-pw/2)","height":"(3*ply + bore_d) - (2*ply + bore_d)","operation":"new","name":"9 doubler","body_name":"9 doubler"}},
{"command":"solid.box","params":{"corner":["sac - exit_l - bird_upstream","-pw/2","2*ply + bore_d + 0*ply"],"length":"(sac + plug) - (sac - exit_l - bird_upstream)","width":"(pw/2) - (-pw/2)","height":"(2*ply + bore_d + 1*ply) - (2*ply + bore_d + 0*ply)","operation":"new","name":"10 bird layer","body_name":"10 bird layer"}},
{"command":"solid.box","params":{"corner":["sac - exit_l - bird_upstream","-pw/2","2*ply + bore_d + 1*ply"],"length":"(sac + plug) - (sac - exit_l - bird_upstream)","width":"(pw/2) - (-pw/2)","height":"(2*ply + bore_d + 2*ply) - (2*ply + bore_d + 1*ply)","operation":"new","name":"11 bird layer","body_name":"11 bird layer"}},
{"command":"solid.box","params":{"corner":["sac - exit_l - bird_upstream","-pw/2","2*ply + bore_d + 2*ply"],"length":"(sac + plug) - (sac - exit_l - bird_upstream)","width":"(pw/2) - (-pw/2)","height":"(2*ply + bore_d + 3*ply) - (2*ply + bore_d + 2*ply)","operation":"new","name":"12 bird layer","body_name":"12 bird layer"}},
{"command":"solid.box","params":{"corner":["-ply","-pw/2","0 mm"],"length":"(0 mm) - (-ply)","width":"(pw/2) - (-pw/2)","height":"(2*ply + bore_d) - (0 mm)","operation":"new","name":"13 mouthpiece cap","body_name":"13 mouthpiece cap"}},
{"command":"solid.combine","params":{"target":"1 top plate","tools":["3 side wall","4 side wall"],"operation":"cut","keep_tools":true,"name":"finger notches, 1 top plate"}},
{"command":"solid.combine","params":{"target":"2 bottom plate","tools":["3 side wall","4 side wall"],"operation":"cut","keep_tools":true,"name":"finger notches, 2 bottom plate"}},
{"command":"solid.box","params":{"corner":["sac - exit_l","-bore_w/2","ply + bore_d - 1 mm"],"length":"(sac) - (sac - exit_l)","width":"(bore_w/2) - (-bore_w/2)","height":"(2*ply + bore_d + 1 mm) - (ply + bore_d - 1 mm)","operation":"cut","targets":["1 top plate"],"name":"exit hole"}},
{"command":"solid.box","params":{"corner":["sac + plug","-bore_w/2","ply + bore_d - 1 mm"],"length":"(sac + plug + window_l) - (sac + plug)","width":"(bore_w/2) - (-bore_w/2)","height":"(2*ply + bore_d + 1 mm) - (ply + bore_d - 1 mm)","operation":"cut","targets":["1 top plate"],"name":"window"}},
{"command":"solid.box","params":{"corner":["sac","-bore_w/2","2*ply + bore_d - flue_depth"],"length":"(sac + plug) - (sac)","width":"(bore_w/2) - (-bore_w/2)","height":"(2*ply + bore_d + 1 mm) - (2*ply + bore_d - flue_depth)","operation":"cut","targets":["1 top plate"],"name":"flue, nest half"}},
{"command":"solid.box","params":{"corner":["sac - exit_l","-bore_w/2","2*ply + bore_d - 1 mm"],"length":"(sac + plug) - (sac - exit_l)","width":"(bore_w/2) - (-bore_w/2)","height":"(2*ply + bore_d + flue_depth) - (2*ply + bore_d - 1 mm)","operation":"cut","targets":["10 bird layer"],"name":"flue, bird half"}},
{"command":"solid.cylinder","params":{"base":["wc + h_1","0 mm","ply + bore_d - 1 mm"],"diameter":"d_1","height":"2*ply + 2 mm","operation":"cut","targets":["1 top plate","9 doubler"],"name":"hole 1"}},
{"command":"solid.cylinder","params":{"base":["wc + h_2","0 mm","ply + bore_d - 1 mm"],"diameter":"d_2","height":"2*ply + 2 mm","operation":"cut","targets":["1 top plate","9 doubler"],"name":"hole 2"}},
{"command":"solid.cylinder","params":{"base":["wc + h_3","0 mm","ply + bore_d - 1 mm"],"diameter":"d_3","height":"2*ply + 2 mm","operation":"cut","targets":["1 top plate","9 doubler"],"name":"hole 3"}},
{"command":"solid.cylinder","params":{"base":["wc + h_4","0 mm","ply + bore_d - 1 mm"],"diameter":"d_4","height":"2*ply + 2 mm","operation":"cut","targets":["1 top plate","9 doubler"],"name":"hole 4"}},
{"command":"solid.cylinder","params":{"base":["wc + h_5","0 mm","ply + bore_d - 1 mm"],"diameter":"d_5","height":"2*ply + 2 mm","operation":"cut","targets":["1 top plate","9 doubler"],"name":"hole 5"}},
{"command":"solid.cylinder","params":{"base":["-ply - 1 mm","0 mm","notch_in"],"axis":[1,0,0],"diameter":"cap_d","height":"ply + 2 mm","operation":"cut","targets":["13 mouthpiece cap"],"name":"cap notch"}},
{"command":"solid.cylinder","params":{"base":["0 mm","0 mm","-1 mm"],"diameter":"cap_d","height":"ply + 2 mm","operation":"cut","targets":["2 bottom plate"],"name":"end notch"}},
{"command":"inspect.measure","params":{}}
]}
